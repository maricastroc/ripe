generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id            String     @id @default(cuid())
  prompt        String
  title         String
  status        String     @default("dormant")
  deliverable   String?
  outcome       String?
  context       String     @default("[]")
  assumptions   String     @default("[]")
  fruit         String?
  isExample     Boolean    @default(false)
  returnAt      DateTime?
  deferredAt    DateTime?
  interpretedAt DateTime?
  plannedAt     DateTime?
  reviewedAt    DateTime?
  ripeAt        DateTime?
  harvestedAt   DateTime?
  stallReason   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  steps         Step[]
  questions     Question[]
  artifacts     Artifact[]
  jobs          Job[]
  events        Event[]

  @@index([status])
}

model Step {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String
  output      String
  status      String    @default("pending")
  needs       String    @default("[]")
  artifact    Artifact?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

model Question {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  position   Int
  text       String
  why        String
  blocking   Boolean   @default(false)
  answer     String?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([taskId])
}

model Artifact {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId          String?  @unique
  step            Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  kind            String
  title           String
  content         String
  previousContent String?
  version         Int      @default(1)
  editedByUser    Boolean  @default(false)
  model           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([taskId])
}

model Job {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId      String?
  artifactId  String?
  type        String
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  leaseUntil  DateTime?
  instruction String?
  partial     String?
  error       String?
  model       String?
  tokens      Int?
  durationMs  Int?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, runAfter])
  @@index([taskId])
}

model Event {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  jobId     String?
  kind      String
  message   String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Setting {
  key   String @id
  value String
}

model AgentState {
  id          Int      @id @default(1)
  state       String   @default("starting")
  message     String?
  jobId       String?
  heartbeatAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
