APP_NAME=Ripe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ripe
DB_USERNAME=ripe
DB_PASSWORD=ripe

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

RIPE_MODE=local
RIPE_GATEWAY_SECRET=
RIPE_GATEWAY_REQUIRED=true
RIPE_VISITOR_COOKIE=ripe_visitor
RIPE_VISITOR_COOKIE_SECURE=false
RIPE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RIPE_INFERENCE_DRIVER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
GROQ_CONCURRENCY=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_SERVICE_TIER=flex
RIPE_ALLOW_PAID_INFERENCE=false
RIPE_DAILY_BUDGET_USD=0.30
RIPE_VISITOR_BUDGET_SHARE=0.10
RIPE_PACE=steady

REVERB_APP_ID=ripe
REVERB_APP_KEY=ripe-local
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
